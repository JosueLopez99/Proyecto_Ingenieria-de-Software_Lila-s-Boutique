@inherits LayoutComponentBase
@using System.Security.Claims
@using LilasBoutique.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- Barra Superior (Top-Row) -->
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white shadow-sm mb-3">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 fs-6 shadow-sm rounded-pill">
                            <i class="bi bi-person-badge me-2"></i> Rol Activo: <strong>@context.User.FindFirst(ClaimTypes.Role)?.Value</strong>
                        </span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="d-flex align-items-center">
                <!-- Botón de Modo Oscuro -->
                <button class="btn btn-outline-secondary border-0 rounded-circle me-3" @onclick="ToggleTheme" title="Cambiar tema">
                    <i class="bi @(isDarkMode ? "bi-sun-fill text-warning" : "bi-moon-stars-fill text-dark") fs-5"></i>
                </button>

                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Ha ocurrido un error inesperado.
    <a href="" class="reload">Recargar Página</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    #region Variables y Ciclo de Vida

    private bool isDarkMode = false;

    /// <summary>
    /// Se dispara cuando el componente ha sido dibujado.
    /// Recupera la preferencia del tema visual desde LocalStorage (JS).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
            isDarkMode = theme == "dark";
            StateHasChanged();
        }
    }

    #endregion

    #region Lógica de Interfaz

    /// <summary>
    /// Invoca el script global de JavaScript para intercambiar las propiedades
    /// CSS de Bootstrap (data-bs-theme).
    /// </summary>
    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("setModoOscuro", isDarkMode);
    }

    #endregion
}