<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Estilos Core -->
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Estilos de Aplicación -->
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="LilasBoutique.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <!-- Pre-renderizado desactivado -->
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <!-- Framework Blazor -->
    <script src="_framework/blazor.web.js"></script>

    <!-- Script Directo: Evita el error 404 de Linux/Docker -->
    <script>

            // GESTIÓN DE TEMAS (MODO CLARO/OSCURO)
            window.setModoOscuro = (isDark) => {
                const theme = isDark ? 'dark' : 'light';
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('theme', theme);
            };

            // Autoejecutable: revisa el LocalStorage
            (function () {
                const theme = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-bs-theme', theme);
            })();

            // ==========================================
            // EVENTOS DE TECLADO NATIVOS (DELEGACIÓN DE EVENTOS)
            // ==========================================
            document.addEventListener('keydown', function (e) {
                if (!e.target || !e.target.classList) return;

                // REGLA 1: Solo Enteros (Para Stock y Límite de Alerta)
                if (e.target.classList.contains('solo-enteros')) {
                    // Bloquea signos matemáticos, letra 'e', coma y PUNTO DECIMAL
                    if (['+', '-', 'e', 'E', ','].includes(e.key)) {
                        e.preventDefault();
                    }
                }
                // REGLA 2: Solo Decimales (Para Precios)
                else if (e.target.classList.contains('solo-decimales')) {
                    // Bloquea signos matemáticos, letra 'e' y coma (PERMITE EL PUNTO)
                    if (['+', '-', 'e', 'E', ','].includes(e.key)) {
                        e.preventDefault();
                    }
                }
            });
    </script>
</body>
</html>