@page "/catalogos"
@rendermode InteractiveServer
@using LilasBoutique.Models
@using LilasBoutique.Data
@using Microsoft.AspNetCore.Authorization
@inject IInventarioService InventarioService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h3 class="fw-bold mb-4">Catálogo General</h3>

@if (!string.IsNullOrEmpty(mensajeNotificacion))
{
    <div class="alert alerta-flotante @(esError ? "error" : "exito") d-flex align-items-center" role="alert">
        <i class="bi @(esError ? "bi-x-octagon-fill text-danger" : "bi-check-circle-fill text-success") fs-3 me-3"></i>
        <div class="flex-grow-1">
            <h6 class="alert-heading fw-bold mb-1">@(esError ? "Atención" : "Operación Exitosa")</h6>
            <p class="mb-0 small">@mensajeNotificacion</p>
        </div>
        <button type="button" class="btn-close ms-2" @onclick="() => mensajeNotificacion = string.Empty"></button>
    </div>
}

<div class="card border-0 shadow-sm p-4">

    <!-- ================= PANEL DE FILTROS INDEPENDIENTES ================= -->
    <div class="row g-2 mb-4 bg-light p-3 rounded border align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-bold text-secondary mb-1">Código</label>
            <input type="text" class="form-control form-control-sm shadow-sm" placeholder="Buscar..." @bind="filtroCodigo" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-secondary mb-1">Marca</label>
            <input type="text" class="form-control form-control-sm shadow-sm" placeholder="Buscar..." @bind="filtroMarca" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-secondary mb-1">Categoría</label>
            <input type="text" class="form-control form-control-sm shadow-sm" placeholder="Buscar..." @bind="filtroCategoria" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-secondary mb-1">Talla</label>
            <input type="text" class="form-control form-control-sm shadow-sm" placeholder="Ej: S, 28..." @bind="filtroTalla" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-secondary mb-1">Color</label>
            <input type="text" class="form-control form-control-sm shadow-sm" placeholder="Buscar..." @bind="filtroColor" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-secondary mb-1">Precio Máx (C$)</label>
            <div class="input-group input-group-sm shadow-sm">
                <!-- Se agregó la clase global 'solo-enteros' -->
                <input type="number" class="form-control solo-enteros" placeholder="0.00" min="0" @bind="filtroPrecioMax" @bind:event="oninput" />
                <button class="btn btn-danger" type="button" title="Limpiar Todos los Filtros" @onclick="LimpiarFiltros">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ================= TABLA DE CATÁLOGO ================= -->
    <div class="table-responsive">
        <ErrorBoundary>
            <ChildContent>
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Código</th>
                            <th class="text-start">Marca</th>
                            <th>Categoría</th>
                            <th>Talla</th>
                            <th>Color</th>
                            <th>Stock</th>
                            <th>Precio</th>

                            <AuthorizeView Roles="Administrador, Vendedor">
                                <Authorized>
                                    <th class="text-end">Acciones</th>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <div class="mt-2 text-muted">Cargando catálogo...</div>
                                </td>
                            </tr>
                        }
                        else if (!catalogoFiltrado.Any())
                        {
                            <tr><td colspan="8" class="text-muted py-4">No se encontraron prendas con estos filtros.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in catalogoFiltrado)
                            {
                                <tr @key="item.IdVariante">
                                    <td class="text-start fw-bold text-secondary">
                                        <i class="bi bi-upc-scan me-1"></i>@(item.Prenda?.CodigoIdentificador ?? "N/A")
                                    </td>
                                    <td class="text-start fw-semibold text-dark">@(item.Prenda?.Marca ?? "Sin Marca")</td>
                                    <td><span class="badge bg-light text-dark border">@(item.Prenda?.Categoria?.NombreCategoria ?? "Sin Categoría")</span></td>
                                    <td>@(item.Talla?.NombreTalla ?? "-")</td>
                                    <td>@(item.Color?.NombreColor ?? "-")</td>
                                    <td>
                                        <span class="badge @(item.StockFisicoActual <= item.LimiteAlerta ? "bg-danger" : "bg-success") rounded-pill px-3 py-2">
                                            @item.StockFisicoActual
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">C$ @(item.Precio)</td>

                                    <AuthorizeView Roles="Administrador, Vendedor">
                                        <Authorized>
                                            <td class="text-end">
                                                <div class="btn-group">
                                                    @if (esAdministrador)
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary" title="Editar Prenda y Precio" @onclick="() => AbrirModalEdicion(item)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => IniciarEliminacion(item.IdVariante)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                    @if (puedeVender)
                                                    {
                                                        <button class="btn btn-sm btn-primary fw-bold ms-1" @onclick="() => AbrirModalVenta(item)">
                                                            <i class="bi bi-cart-plus me-1"></i> Vender
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </Authorized>
                                    </AuthorizeView>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="alert alert-danger m-3">
                    <h5 class="fw-bold"><i class="bi bi-bug me-2"></i>Error interno de renderizado</h5>
                    <p>Se encontró un error que impidió dibujar la tabla:</p>
                    <code>@ex.Message</code>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </div>
</div>

<!-- ================= MODAL DE VENTA ================= -->
@if (mostrarModalVenta)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cart-check me-2"></i>Registrar Venta</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <div class="bg-light p-3 rounded mb-3 border">
                        <p class="mb-1"><strong class="text-primary">Código:</strong> @varianteSeleccionada?.Prenda?.CodigoIdentificador</p>
                        <p class="mb-0"><strong>Prenda:</strong> @varianteSeleccionada?.Prenda?.Marca - @varianteSeleccionada?.Prenda?.Categoria?.NombreCategoria</p>
                    </div>
                    <p class="mb-4 text-center"><strong>Talla:</strong> @varianteSeleccionada?.Talla?.NombreTalla | <strong>Color:</strong> @varianteSeleccionada?.Color?.NombreColor</p>

                    <div class="alert py-2 text-center" style="background-color: #cff4fc !important; border: 1px solid #b6effb !important; color: #055160 !important;">
                        <i class="bi bi-box-seam me-2"></i>Stock Disponible: <strong style="color: #055160 !important; font-weight: 800;">@varianteSeleccionada?.StockFisicoActual unidades</strong>
                    </div>

                    <label class="form-label fw-bold">Cantidad a Vender:</label>
                    <!-- Se agregó la clase global 'solo-enteros' -->
                    <input type="number" @bind="cantidadVenta" class="form-control form-control-lg text-center solo-enteros" min="1" max="@varianteSeleccionada?.StockFisicoActual" />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales">Cancelar</button>
                    <button type="button" class="btn btn-success fw-bold" @onclick="ConfirmarVenta">Confirmar Venta</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL DE EDICIÓN ================= -->
@if (esAdministrador && mostrarModalEdicion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Prenda y Precio</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Código Identificador:</label>
                        <input type="text" @bind="varianteSeleccionada!.Prenda!.CodigoIdentificador" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Marca de la Prenda:</label>
                        <input type="text" @bind="varianteSeleccionada!.Prenda!.Marca" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nuevo Precio de Venta (C$):</label>
                        <input type="number" @bind="varianteSeleccionada!.Precio" class="form-control form-control-lg text-success fw-bold solo-enteros" min="0" step="any" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModales">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="ConfirmarEdicion">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL DE ADVERTENCIA PARA ELIMINAR ================= -->
@if (esAdministrador && mostrarModalEliminacion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Advertencia de Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-trash3 text-warning display-4 mb-3"></i>
                    <p class="fs-5 mb-1">¿Está seguro de que desea eliminar esta variante?</p>
                    <p class="text-muted small">Esta acción borrará el registro del catálogo general permanentemente.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales">Cancelar</button>
                    <button type="button" class="btn btn-danger fw-bold" @onclick="EjecutarEliminacion">Sí, Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    #region Variables de Estado y UI
    private string mensajeNotificacion = "";
    private bool esError = false;
    private bool cargando = true;

    // RBAC Variables
    private bool esAdministrador = false;
    private bool puedeVender = false;
    private string correoUsuarioActual = "";

    // Data Sources
    private List<VariantePrenda> catalogoCompleto = new();
    private List<VariantePrenda> catalogoFiltrado = new();

    // Modal Variables
    private bool mostrarModalVenta = false;
    private bool mostrarModalEdicion = false;
    private bool mostrarModalEliminacion = false;
    private VariantePrenda varianteSeleccionada = new();
    private int idVarianteAEliminar = 0;
    private int cantidadVenta = 1;
    #endregion

    #region Variables de Filtros Independientes
    private string _filtroCodigo = "";
    private string filtroCodigo { get => _filtroCodigo; set { _filtroCodigo = value; FiltrarCatalogo(); } }

    private string _filtroMarca = "";
    private string filtroMarca { get => _filtroMarca; set { _filtroMarca = value; FiltrarCatalogo(); } }

    private string _filtroCategoria = "";
    private string filtroCategoria { get => _filtroCategoria; set { _filtroCategoria = value; FiltrarCatalogo(); } }

    private string _filtroTalla = "";
    private string filtroTalla { get => _filtroTalla; set { _filtroTalla = value; FiltrarCatalogo(); } }

    private string _filtroColor = "";
    private string filtroColor { get => _filtroColor; set { _filtroColor = value; FiltrarCatalogo(); } }

    private decimal? _filtroPrecioMax = null;
    private decimal? filtroPrecioMax { get => _filtroPrecioMax; set { _filtroPrecioMax = value; FiltrarCatalogo(); } }
    #endregion

    #region Ciclo de Vida del Componente
    /// <summary>
    /// Se ejecuta al inicializar el componente. Configura el estado de autenticación y los permisos RBAC.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            esAdministrador = user.IsInRole("Administrador");
            puedeVender = user.IsInRole("Administrador") || user.IsInRole("Vendedor");
            correoUsuarioActual = user.Identity.Name ?? "";
        }
    }

    /// <summary>
    /// Se ejecuta después del primer renderizado. Carga los datos pesados del catálogo
    /// para evitar bloquear la carga inicial de la UI.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                catalogoCompleto = await InventarioService.ObtenerCatalogo();
                FiltrarCatalogo();
                cargando = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                await MostrarMensaje($"Error crítico de base de datos: {ex.Message}", true);
                cargando = false;
                StateHasChanged();
            }
        }
    }
    #endregion

    #region Lógica de Negocio y Filtrado
    /// <summary>
    /// Aplica todos los filtros activos sobre la lista en memoria del catálogo completo.
    /// </summary>
    private void FiltrarCatalogo()
    {
        if (catalogoCompleto == null) return;

        var consulta = catalogoCompleto.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroCodigo))
            consulta = consulta.Where(v => v.Prenda?.CodigoIdentificador?.ToLower().Contains(filtroCodigo.ToLower()) ?? false);

        if (!string.IsNullOrWhiteSpace(filtroMarca))
            consulta = consulta.Where(v => v.Prenda?.Marca?.ToLower().Contains(filtroMarca.ToLower()) ?? false);

        if (!string.IsNullOrWhiteSpace(filtroCategoria))
            consulta = consulta.Where(v => v.Prenda?.Categoria?.NombreCategoria?.ToLower().Contains(filtroCategoria.ToLower()) ?? false);

        if (!string.IsNullOrWhiteSpace(filtroTalla))
            consulta = consulta.Where(v => v.Talla?.NombreTalla?.ToLower().Contains(filtroTalla.ToLower()) ?? false);

        if (!string.IsNullOrWhiteSpace(filtroColor))
            consulta = consulta.Where(v => v.Color?.NombreColor?.ToLower().Contains(filtroColor.ToLower()) ?? false);

        if (filtroPrecioMax.HasValue)
            consulta = consulta.Where(v => v.Precio <= filtroPrecioMax.Value);

        catalogoFiltrado = consulta.ToList();
    }

    /// <summary>
    /// Reinicia todos los filtros a su estado por defecto y recarga la tabla completa.
    /// </summary>
    private void LimpiarFiltros()
    {
        _filtroCodigo = "";
        _filtroMarca = "";
        _filtroCategoria = "";
        _filtroTalla = "";
        _filtroColor = "";
        _filtroPrecioMax = null;
        FiltrarCatalogo();
    }

    /// <summary>
    /// Procesa la venta de la variante seleccionada, descontando el stock y generando un registro histórico.
    /// </summary>
    private async Task ConfirmarVenta()
    {
        if (cantidadVenta <= 0)
        {
            await MostrarMensaje("Debe ingresar una cantidad válida mayor a 0.", true);
            return;
        }

        if (cantidadVenta > varianteSeleccionada.StockFisicoActual)
        {
            await MostrarMensaje($"Error: Solo hay {varianteSeleccionada.StockFisicoActual} unidades en stock.", true);
            return;
        }

        try
        {
            await InventarioService.RegistrarVenta(varianteSeleccionada.IdVariante, cantidadVenta, correoUsuarioActual);
            await MostrarMensaje($"¡Venta registrada exitosamente! Se descontaron {cantidadVenta} unidades.", false);

            CerrarModales();
            catalogoCompleto = await InventarioService.ObtenerCatalogo();
            FiltrarCatalogo();
        }
        catch (Exception ex)
        {
            await MostrarMensaje($"Error al procesar la venta: {ex.Message}", true);
        }
    }

    /// <summary>
    /// Actualiza los detalles de la variante seleccionada en la base de datos (Precio, Marca, Código).
    /// </summary>
    private async Task ConfirmarEdicion()
    {
        if (string.IsNullOrWhiteSpace(varianteSeleccionada?.Prenda?.CodigoIdentificador))
        {
            await MostrarMensaje("El código identificador no puede estar vacío.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(varianteSeleccionada?.Prenda?.Marca))
        {
            await MostrarMensaje("La marca de la prenda no puede estar vacía.", true);
            return;
        }

        if (varianteSeleccionada?.Precio < 0)
        {
            await MostrarMensaje("El precio no puede ser un valor negativo.", true);
            return;
        }

        try
        {
            await InventarioService.ActualizarVariante(varianteSeleccionada!);
            await MostrarMensaje("¡Prenda y precio actualizados correctamente!", false);

            CerrarModales();
            catalogoCompleto = await InventarioService.ObtenerCatalogo();
            FiltrarCatalogo();
        }
        catch (Exception ex)
        {
            await MostrarMensaje($"Error al actualizar: {ex.Message}", true);
        }
    }

    /// <summary>
    /// Elimina de forma lógica o permanente una variante del catálogo, dependiendo del historial de stock.
    /// </summary>
    private async Task EjecutarEliminacion()
    {
        try
        {
            await InventarioService.EliminarVariante(idVarianteAEliminar);
            await MostrarMensaje("¡El registro fue eliminado exitosamente del catálogo!", false);

            CerrarModales();
            catalogoCompleto = await InventarioService.ObtenerCatalogo();
            FiltrarCatalogo();
        }
        catch (Exception)
        {
            CerrarModales();
            await MostrarMensaje("No se puede eliminar: Esta prenda ya tiene un historial de movimientos en bodega.", true);
        }
    }
    #endregion

    #region Control de Modales y Notificaciones
    private async Task AbrirModalVenta(VariantePrenda variante)
    {
        if (variante.StockFisicoActual <= 0)
        {
            await MostrarMensaje("No hay stock disponible para vender esta prenda.", true);
            return;
        }
        varianteSeleccionada = variante;
        cantidadVenta = 1;
        mostrarModalVenta = true;
    }

    private void AbrirModalEdicion(VariantePrenda variante)
    {
        // Se clona el objeto para no afectar la UI principal si el usuario cancela la edición
        varianteSeleccionada = new VariantePrenda
        {
            IdVariante = variante.IdVariante,
            Precio = variante.Precio,
            PrendaId = variante.PrendaId,
            Prenda = new Prenda
            {
                IdPrenda = variante.Prenda?.IdPrenda ?? 0,
                CodigoIdentificador = variante.Prenda?.CodigoIdentificador ?? "",
                Marca = variante.Prenda?.Marca ?? "",
                CategoriaId = variante.Prenda?.CategoriaId ?? 0
            }
        };
        mostrarModalEdicion = true;
    }

    private void IniciarEliminacion(int id)
    {
        idVarianteAEliminar = id;
        mostrarModalEliminacion = true;
    }

    private void CerrarModales()
    {
        mostrarModalVenta = false;
        mostrarModalEdicion = false;
        mostrarModalEliminacion = false;
    }

    /// <summary>
    /// Muestra un Toast asíncrono que desaparece tras 4 segundos sin bloquear la UI.
    /// </summary>
    private Task MostrarMensaje(string msj, bool error)
    {
        mensajeNotificacion = msj;
        esError = error;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            await InvokeAsync(() =>
            {
                mensajeNotificacion = string.Empty;
                StateHasChanged();
            });
        });

        return Task.CompletedTask;
    }
    #endregion
}