@page "/parametros"
@rendermode InteractiveServer
@using LilasBoutique.Models
@using LilasBoutique.Data
@using Microsoft.AspNetCore.Authorization
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IInventarioService InventarioService

<h3 class="fw-bold mb-4">Gestión de Atributos de Prenda</h3>

@if (!string.IsNullOrEmpty(mensajeNotificacion))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @(esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
        @mensajeNotificacion
        <button type="button" class="btn-close" @onclick="() => mensajeNotificacion = string.Empty"></button>
    </div>
}

<div class="row g-4 align-items-start">
    <!-- ================= PANEL DE CATEGORÍAS ================= -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary text-white fw-bold">
                <i class="bi bi-tags me-2"></i>@(nuevaCategoria.IdCategoria == 0 ? "Nueva" : "Editar") Categoría
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary fw-semibold">Nombre de Categoría</label>
                    <InputText @bind-Value="nuevaCategoria.NombreCategoria" class="form-control" placeholder="Ej: Camisas" />
                </div>
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-primary w-100 fw-bold" @onclick="GuardarCategoria">
                        @(nuevaCategoria.IdCategoria == 0 ? "Guardar" : "Actualizar") Categoría
                    </button>
                    @if (nuevaCategoria.IdCategoria != 0)
                    {
                        <button class="btn btn-secondary w-50" @onclick="() => nuevaCategoria = new Categoria()">Cancelar</button>
                    }
                </div>

                <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">Registradas:</h6>
                <ul class="list-group list-group-flush small">
                    @foreach (var cat in categorias)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-bottom-0">
                            <span class="fw-semibold">@cat.NombreCategoria</span>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-primary border-0" title="Editar" @onclick="() => EditarCategoria(cat)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger border-0" title="Eliminar" @onclick="() => BorrarCategoria(cat.IdCategoria)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- ================= PANEL DE TALLAS ORGANIZADAS ================= -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-success text-white fw-bold">
                <i class="bi bi-rulers me-2"></i>@(nuevaTalla.IdTalla == 0 ? "Nueva" : "Editar") Talla
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary fw-semibold">Categoría Perteneciente</label>
                    <InputSelect @bind-Value="nuevaTalla.CategoriaId" class="form-select">
                        <option value="0">Seleccione...</option>
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.IdCategoria">@cat.NombreCategoria</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary fw-semibold">Nombre de Talla</label>
                    <InputText @bind-Value="nuevaTalla.NombreTalla" class="form-control" placeholder="Ej: S, M, L o 32" />
                </div>
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-success w-100 fw-bold" @onclick="GuardarTalla">
                        @(nuevaTalla.IdTalla == 0 ? "Guardar" : "Actualizar") Talla
                    </button>
                    @if (nuevaTalla.IdTalla != 0)
                    {
                        <button class="btn btn-secondary w-50" @onclick="() => nuevaTalla = new Talla()">Cancelar</button>
                    }
                </div>

                <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">Tallas por Categoría:</h6>

                @* Lógica de agrupación por categorías *@
                <div class="accordion-container" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                    @foreach (var cat in categorias)
                    {
                        var tallasDeEstaCategoria = tallas.Where(t => t.CategoriaId == cat.IdCategoria).ToList();

                        <div class="mb-3 border rounded shadow-sm bg-light">
                            <div class="bg-white border-bottom px-3 py-2 rounded-top d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success"><i class="bi bi-tag-fill me-2"></i>@cat.NombreCategoria</span>
                                <span class="badge bg-secondary rounded-pill">@tallasDeEstaCategoria.Count</span>
                            </div>
                            <div class="p-2">
                                @if (!tallasDeEstaCategoria.Any())
                                {
                                    <div class="text-muted small fst-italic text-center py-2">Sin tallas registradas</div>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush small">
                                        @foreach (var talla in tallasDeEstaCategoria)
                                        {
                                            <li class="list-group-item px-2 py-1 bg-transparent d-flex justify-content-between align-items-center">
                                                <span class="fw-semibold text-dark">@talla.NombreTalla</span>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-sm text-primary p-0 me-2" title="Editar" @onclick="() => EditarTalla(talla)">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm text-danger p-0" title="Eliminar" @onclick="() => BorrarTalla(talla.IdTalla)">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ================= PANEL DE COLORES ================= -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="bi bi-palette me-2"></i>@(nuevoColor.IdColor == 0 ? "Nuevo" : "Editar") Color
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-secondary fw-semibold">Nombre del Color</label>
                    <InputText @bind-Value="nuevoColor.NombreColor" class="form-control" placeholder="Ej: Azul Marino" />
                </div>
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-warning w-100 fw-bold" @onclick="GuardarColor">
                        @(nuevoColor.IdColor == 0 ? "Guardar" : "Actualizar") Color
                    </button>
                    @if (nuevoColor.IdColor != 0)
                    {
                        <button class="btn btn-secondary w-50" @onclick="() => nuevoColor = new Color()">Cancelar</button>
                    }
                </div>

                <h6 class="fw-bold text-secondary border-bottom pb-2 mb-3">Registrados:</h6>
                <ul class="list-group list-group-flush small">
                    @foreach (var color in colores)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-bottom-0">
                            <span class="fw-semibold">@color.NombreColor</span>
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-warning border-0" title="Editar" @onclick="() => EditarColor(color)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger border-0" title="Eliminar" @onclick="() => BorrarColor(color.IdColor)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private string mensajeNotificacion = "";
    private bool esError = false;

    private Categoria nuevaCategoria = new();
    private Talla nuevaTalla = new();
    private Color nuevoColor = new();

    private List<Categoria> categorias = new();
    private List<Talla> tallas = new();
    private List<Color> colores = new();

    protected override async Task OnInitializedAsync()
    {
        // Validación de seguridad por rol: Solo Administrador
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.IsInRole("Administrador"))
        {
            if (user.IsInRole("Vendedor"))
            {
                Navigation.NavigateTo("/catalogos");
                return;
            }
            else if (user.IsInRole("Bodeguero"))
            {
                Navigation.NavigateTo("/bodega");
                return;
            }
            else
            {
                Navigation.NavigateTo("/");
                return;
            }
        }

        try
        {
            await CargarListas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico al cargar atributos: {ex.Message}");
        }
    }

    private async Task CargarListas()
    {
        categorias = await InventarioService.ObtenerCategorias();
        tallas = await InventarioService.ObtenerTallas();
        colores = await InventarioService.ObtenerColores();
    }

    // --- MÉTODOS DE CARGA PARA EDICIÓN ---
    private void EditarCategoria(Categoria cat)
    {
        nuevaCategoria = new Categoria { IdCategoria = cat.IdCategoria, NombreCategoria = cat.NombreCategoria };
    }

    private void EditarTalla(Talla talla)
    {
        nuevaTalla = new Talla { IdTalla = talla.IdTalla, NombreTalla = talla.NombreTalla, CategoriaId = talla.CategoriaId };
    }

    private void EditarColor(Color color)
    {
        nuevoColor = new Color { IdColor = color.IdColor, NombreColor = color.NombreColor };
    }

    // --- MÉTODOS DE GUARDADO (CREAR Y ACTUALIZAR) ---
    private async Task GuardarCategoria()
    {
        if (string.IsNullOrWhiteSpace(nuevaCategoria.NombreCategoria))
        {
            MostrarMensaje("Por favor, escribe un nombre para la Categoría.", true);
            return;
        }

        try
        {
            if (nuevaCategoria.IdCategoria == 0)
            {
                await InventarioService.AgregarCategoria(nuevaCategoria);
                MostrarMensaje("¡Categoría guardada exitosamente!", false);
            }
            else
            {
                await InventarioService.ActualizarCategoria(nuevaCategoria);
                MostrarMensaje("¡Categoría actualizada exitosamente!", false);
            }

            nuevaCategoria = new Categoria();
            await CargarListas();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al guardar categoría: {ex.Message}", true);
        }
    }

    private async Task GuardarTalla()
    {
        if (nuevaTalla.CategoriaId == 0 || string.IsNullOrWhiteSpace(nuevaTalla.NombreTalla))
        {
            MostrarMensaje("Por favor, selecciona una categoría y escribe un nombre para la Talla.", true);
            return;
        }

        try
        {
            if (nuevaTalla.IdTalla == 0)
            {
                await InventarioService.AgregarTalla(nuevaTalla);
                MostrarMensaje("¡Talla guardada exitosamente!", false);
            }
            else
            {
                await InventarioService.ActualizarTalla(nuevaTalla);
                MostrarMensaje("¡Talla actualizada exitosamente!", false);
            }

            nuevaTalla = new Talla();
            await CargarListas();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al guardar talla: {ex.Message}", true);
        }
    }

    private async Task GuardarColor()
    {
        if (string.IsNullOrWhiteSpace(nuevoColor.NombreColor))
        {
            MostrarMensaje("Por favor, escribe un nombre para el Color.", true);
            return;
        }

        try
        {
            if (nuevoColor.IdColor == 0)
            {
                await InventarioService.AgregarColor(nuevoColor);
                MostrarMensaje("¡Color guardado exitosamente!", false);
            }
            else
            {
                await InventarioService.ActualizarColor(nuevoColor);
                MostrarMensaje("¡Color actualizado exitosamente!", false);
            }

            nuevoColor = new Color();
            await CargarListas();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al guardar color: {ex.Message}", true);
        }
    }

    // --- MÉTODOS DE BORRADO ---
    private async Task BorrarCategoria(int id)
    {
        try
        {
            await InventarioService.EliminarCategoria(id);
            await CargarListas();
            MostrarMensaje("Categoría eliminada correctamente.", false);
        }
        catch (Exception)
        {
            MostrarMensaje("No se puede eliminar: Esta categoría ya está siendo usada o tiene tallas vinculadas.", true);
        }
    }

    private async Task BorrarTalla(int id)
    {
        try
        {
            await InventarioService.EliminarTalla(id);
            await CargarListas();
            MostrarMensaje("Talla eliminada correctamente.", false);
        }
        catch (Exception)
        {
            MostrarMensaje("No se puede eliminar: Esta talla ya está asignada a una prenda en el inventario.", true);
        }
    }

    private async Task BorrarColor(int id)
    {
        try
        {
            await InventarioService.EliminarColor(id);
            await CargarListas();
            MostrarMensaje("Color eliminado correctamente.", false);
        }
        catch (Exception)
        {
            MostrarMensaje("No se puede eliminar: Este color ya está asignado a una prenda en el inventario.", true);
        }
    }

    private void MostrarMensaje(string mensaje, bool error)
    {
        mensajeNotificacion = mensaje;
        esError = error;
    }
}