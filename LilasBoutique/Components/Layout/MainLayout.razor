@inherits LayoutComponentBase
@using System.Security.Claims
@using LilasBoutique.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white shadow-sm mb-3">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 fs-6 shadow-sm rounded-pill">
                            <i class="bi bi-person-badge me-2"></i> Rol Activo: <strong>@context.User.FindFirst(ClaimTypes.Role)?.Value</strong>
                        </span>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="d-flex align-items-center">
                <!-- Botón de Cambio de Tema (Modo Oscuro/Claro) -->
                <button class="btn btn-outline-secondary border-0 rounded-circle me-3" @onclick="ToggleTheme" title="Cambiar tema">
                    <i class="bi @(isDarkMode ? "bi-sun-fill text-warning" : "bi-moon-stars-fill text-dark") fs-5"></i>
                </button>

                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
@code {
    private bool isDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sincronizar únicamente el Modo Oscuro al recargar o abrir
            var theme = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
            isDarkMode = theme == "dark";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("setModoOscuro", isDarkMode);
    }
}