@page "/catalogos"
@attribute [Authorize(Roles = "Administrador, Vendedor, Bodeguero")]
@rendermode InteractiveServer
@using LilasBoutique.Models
@using LilasBoutique.Data
@using Microsoft.AspNetCore.Authorization
@inject IInventarioService InventarioService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h3 class="fw-bold mb-4">Catálogo General</h3>

@if (!string.IsNullOrEmpty(mensajeNotificacion))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi @(esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>
        <strong>@(esError ? "Error: " : "¡Éxito! ")</strong> @mensajeNotificacion
        <button type="button" class="btn-close" @onclick="() => mensajeNotificacion = string.Empty"></button>
    </div>
}

<div class="card border-0 shadow-sm p-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Buscar por código, marca, categoría o talla..."
                       @bind="TextoBusqueda" @bind:event="oninput" />
                <button class="btn btn-primary px-4" @onclick="FiltrarCatalogo">Filtrar</button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <ErrorBoundary>
            <ChildContent>
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <!-- NUEVA COLUMNA: CÓDIGO -->
                            <th class="text-start">Código</th>
                            <th class="text-start">Marca</th>
                            <th>Categoría</th>
                            <th>Talla</th>
                            <th>Color</th>
                            <th>Stock</th>
                            <th>Precio</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <div class="mt-2 text-muted">Cargando catálogo...</div>
                                </td>
                            </tr>
                        }
                        else if (!catalogoFiltrado.Any())
                        {
                            <tr><td colspan="8" class="text-muted py-4">No se encontraron prendas en el catálogo.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in catalogoFiltrado)
                            {
                                <tr @key="item.IdVariante">
                                    <!-- MOSTRAR EL CÓDIGO -->
                                    <td class="text-start fw-bold text-secondary">
                                        <i class="bi bi-upc-scan me-1"></i>@(item.Prenda?.CodigoIdentificador ?? "N/A")
                                    </td>
                                    <td class="text-start fw-semibold text-dark">@(item.Prenda?.Marca ?? "Sin Marca")</td>
                                    <td><span class="badge bg-light text-dark border">@(item.Prenda?.Categoria?.NombreCategoria ?? "Sin Categoría")</span></td>
                                    <td>@(item.Talla?.NombreTalla ?? "-")</td>
                                    <td>@(item.Color?.NombreColor ?? "-")</td>
                                    <td>
                                        <span class="badge @(item.StockFisicoActual <= item.LimiteAlerta ? "bg-danger" : "bg-success") rounded-pill px-3 py-2">
                                            @item.StockFisicoActual
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">C$ @(item.Precio)</td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            @if (esAdministrador)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" title="Editar Prenda y Precio" @onclick="() => AbrirModalEdicion(item)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => IniciarEliminacion(item.IdVariante)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }

                                            @if (puedeVender)
                                            {
                                                <button class="btn btn-sm btn-primary fw-bold ms-1" @onclick="() => AbrirModalVenta(item)">
                                                    <i class="bi bi-cart-plus me-1"></i> Vender
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="alert alert-danger m-3">
                    <h5 class="fw-bold"><i class="bi bi-bug me-2"></i>Error interno de renderizado</h5>
                    <p>Se encontró un error que impidió dibujar la tabla:</p>
                    <code>@ex.Message</code>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </div>
</div>

<!-- ================= MODAL DE VENTA ================= -->
@if (mostrarModalVenta)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cart-check me-2"></i>Registrar Venta</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <div class="bg-light p-3 rounded mb-3 border">
                        <p class="mb-1"><strong class="text-primary">Código:</strong> @varianteSeleccionada?.Prenda?.CodigoIdentificador</p>
                        <p class="mb-0"><strong>Prenda:</strong> @varianteSeleccionada?.Prenda?.Marca - @varianteSeleccionada?.Prenda?.Categoria?.NombreCategoria</p>
                    </div>
                    <p class="mb-4 text-center"><strong>Talla:</strong> @varianteSeleccionada?.Talla?.NombreTalla | <strong>Color:</strong> @varianteSeleccionada?.Color?.NombreColor</p>

                    <div class="alert alert-info py-2 text-center">
                        <i class="bi bi-box-seam me-2"></i>Stock Disponible: <strong>@varianteSeleccionada?.StockFisicoActual unidades</strong>
                    </div>

                    <label class="form-label fw-bold">Cantidad a Vender:</label>
                    <input type="number" @bind="cantidadVenta" class="form-control form-control-lg text-center" min="1" max="@varianteSeleccionada?.StockFisicoActual" />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales">Cancelar</button>
                    <button type="button" class="btn btn-success fw-bold" @onclick="ConfirmarVenta">Confirmar Venta</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL DE EDICIÓN ================= -->
@if (esAdministrador && mostrarModalEdicion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Prenda y Precio</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Código Identificador:</label>
                        <input type="text" @bind="varianteSeleccionada!.Prenda!.CodigoIdentificador" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Marca de la Prenda:</label>
                        <input type="text" @bind="varianteSeleccionada!.Prenda!.Marca" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nuevo Precio de Venta (C$):</label>
                        <input type="number" @bind="varianteSeleccionada!.Precio" class="form-control form-control-lg text-success fw-bold" min="0" step="any" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModales">Cancelar</button>
                    <button type="button" class="btn btn-primary fw-bold" @onclick="ConfirmarEdicion">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ================= MODAL DE ADVERTENCIA PARA ELIMINAR ================= -->
@if (esAdministrador && mostrarModalEliminacion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Advertencia de Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-trash3 text-warning display-4 mb-3"></i>
                    <p class="fs-5 mb-1">¿Está seguro de que desea eliminar esta variante?</p>
                    <p class="text-muted small">Esta acción borrará el registro del catálogo general permanentemente.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModales">Cancelar</button>
                    <button type="button" class="btn btn-danger fw-bold" @onclick="EjecutarEliminacion">Sí, Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string mensajeNotificacion = "";
    private bool esError = false;
    private bool cargando = true;
    private bool esAdministrador = false;
    private bool puedeVender = false;

    private List<VariantePrenda> catalogoCompleto = new();
    private List<VariantePrenda> catalogoFiltrado = new();

    private string _textoBusqueda = "";
    private string TextoBusqueda
    {
        get => _textoBusqueda;
        set { _textoBusqueda = value; FiltrarCatalogo(); }
    }

    private bool mostrarModalVenta = false;
    private bool mostrarModalEdicion = false;
    private bool mostrarModalEliminacion = false;
    private VariantePrenda varianteSeleccionada = new();
    private int idVarianteAEliminar = 0;
    private int cantidadVenta = 1;

    // NUEVA VARIABLE: Usaremos el correo en lugar del ID
    private string correoUsuarioActual = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            esAdministrador = user.IsInRole("Administrador");
            puedeVender = user.IsInRole("Administrador") || user.IsInRole("Vendedor");

            // Capturamos el correo exacto de la sesión
            correoUsuarioActual = user.Identity.Name ?? "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                catalogoCompleto = await InventarioService.ObtenerCatalogo();
                FiltrarCatalogo();
                cargando = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                MostrarMensaje($"Error crítico de base de datos: {ex.Message}", true);
                cargando = false;
                StateHasChanged();
            }
        }
    }

    private void FiltrarCatalogo()
    {
        if (catalogoCompleto == null) return;

        if (string.IsNullOrWhiteSpace(TextoBusqueda))
        {
            catalogoFiltrado = catalogoCompleto.Where(v => v != null).ToList();
        }
        else
        {
            var b = TextoBusqueda.ToLower();
            catalogoFiltrado = catalogoCompleto.Where(v => v != null && (
                (v.Prenda?.CodigoIdentificador?.ToLower().Contains(b) ?? false) ||
                (v.Prenda?.Marca?.ToLower().Contains(b) ?? false) ||
                (v.Prenda?.Categoria?.NombreCategoria?.ToLower().Contains(b) ?? false) ||
                (v.Talla?.NombreTalla?.ToLower().Contains(b) ?? false) ||
                (v.Color?.NombreColor?.ToLower().Contains(b) ?? false)
            )).ToList();
        }
    }

    private void AbrirModalVenta(VariantePrenda variante)
    {
        if (variante.StockFisicoActual <= 0)
        {
            MostrarMensaje("No hay stock disponible para vender esta prenda.", true);
            return;
        }
        varianteSeleccionada = variante;
        cantidadVenta = 1;
        mostrarModalVenta = true;
        MostrarMensaje("", false);
    }

    private async Task ConfirmarVenta()
    {
        if (cantidadVenta <= 0)
        {
            MostrarMensaje("Debe ingresar una cantidad válida mayor a 0.", true);
            CerrarModales(); return;
        }

        if (cantidadVenta > varianteSeleccionada.StockFisicoActual)
        {
            MostrarMensaje($"Error: Solo hay {varianteSeleccionada.StockFisicoActual} unidades en stock.", true);
            CerrarModales(); return;
        }

        try
        {
            // CORREGIDO: Pasamos la variable 'correoUsuarioActual' (string) en lugar del ID numérico
            await InventarioService.RegistrarVenta(varianteSeleccionada.IdVariante, cantidadVenta, correoUsuarioActual);

            MostrarMensaje($"¡Venta registrada exitosamente! Se descontaron {cantidadVenta} unidades.", false);
            CerrarModales();

            catalogoCompleto = await InventarioService.ObtenerCatalogo();
            FiltrarCatalogo();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al procesar la venta: {ex.Message}", true);
            CerrarModales();
        }
    }

    private void AbrirModalEdicion(VariantePrenda variante)
    {
        varianteSeleccionada = new VariantePrenda
        {
            IdVariante = variante.IdVariante,
            Precio = variante.Precio,
            PrendaId = variante.PrendaId,
            Prenda = new Prenda
            {
                IdPrenda = variante.Prenda?.IdPrenda ?? 0,
                CodigoIdentificador = variante.Prenda?.CodigoIdentificador ?? "",
                Marca = variante.Prenda?.Marca ?? "",
                CategoriaId = variante.Prenda?.CategoriaId ?? 0
            }
        };
        mostrarModalEdicion = true;
    }

    private async Task ConfirmarEdicion()
    {
        try
        {
            await InventarioService.ActualizarVariante(varianteSeleccionada);
            MostrarMensaje("¡Prenda y precio actualizados correctamente!", false);
            CerrarModales();

            catalogoCompleto = await InventarioService.ObtenerCatalogo();
            FiltrarCatalogo();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al actualizar: {ex.Message}", true);
        }
    }

    private void IniciarEliminacion(int id)
    {
        idVarianteAEliminar = id;
        mostrarModalEliminacion = true;
    }

    private async Task EjecutarEliminacion()
    {
        try
        {
            await InventarioService.EliminarVariante(idVarianteAEliminar);
            CerrarModales();
            MostrarMensaje("¡El registro fue eliminado exitosamente del catálogo!", false);

            catalogoCompleto = await InventarioService.ObtenerCatalogo();
            FiltrarCatalogo();
        }
        catch (Exception)
        {
            CerrarModales();
            MostrarMensaje("No se puede eliminar: Esta prenda ya tiene un historial de movimientos en bodega.", true);
        }
    }

    private void CerrarModales()
    {
        mostrarModalVenta = false;
        mostrarModalEdicion = false;
        mostrarModalEliminacion = false;
    }

    private void MostrarMensaje(string msj, bool error)
    {
        mensajeNotificacion = msj;
        esError = error;
    }
}