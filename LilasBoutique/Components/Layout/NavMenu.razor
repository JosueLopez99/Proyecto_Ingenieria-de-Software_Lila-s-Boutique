@using LilasBoutique.Data

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="dashboard">Lila's Boutique</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <!-- DASHBOARD (Solo Admin) -->
        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="dashboard" data-enhance-nav="false">
                        <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- CATÁLOGOS (Admin, Vendedor, Bodeguero) -->
        <AuthorizeView Roles="Administrador, Vendedor, Bodeguero">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="catalogos" data-enhance-nav="false">
                        <span class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></span> Catálogos
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- BODEGA (Admin, Bodeguero) -->
        <AuthorizeView Roles="Administrador, Bodeguero">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="bodega" data-enhance-nav="false">
                        <span class="bi bi-box-seam-fill" aria-hidden="true"></span> Bodega
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- GESTIÓN GENERAL (Solo Admin) -->
        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="registrar-prenda" data-enhance-nav="false">
                        <span class="bi bi-tags-fill" aria-hidden="true"></span> Registrar Prenda
                    </a>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="parametros" data-enhance-nav="false">
                        <span class="bi bi-gear-fill" aria-hidden="true"></span> Atributos (Cat, Tal, Col)
                    </a>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="usuarios" data-enhance-nav="false">
                        <span class="bi bi-people-fill" aria-hidden="true"></span> Usuarios (RBAC)
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- SEGURIDAD Y CIERRE DE SESIÓN (Todos los usuarios autenticados) -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-4 border-top pt-2 border-secondary">
                    <a class="nav-link" href="configuracion" data-enhance-nav="false">
                        <span class="bi bi-shield-lock-fill" aria-hidden="true"></span> Seguridad
                    </a>
                </div>
                <div class="nav-item px-3">
                    <button type="button" class="nav-link btn btn-link w-100 text-start text-white" @onclick="CerrarSesion">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesión
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@inject IJSRuntime JS
@code {
    [Inject]
    private CustomAuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    /// <summary>
    /// Finaliza la sesión actual limpiando el circuito Blazor y destruyendo
    /// la cookie del navegador vía JS, forzando una recarga de página al Login.
    /// </summary>
    private async Task CerrarSesion()
    {
        // 1. Borramos la cookie de sesión nativamente
        await JS.InvokeVoidAsync("eval", "document.cookie = 'lila_user=; path=/; max-age=0;';");

        // 2. Limpiamos la memoria del servidor de Blazor
        await AuthStateProvider.ActualizarEstadoAutenticacion(null);

        // 3. Forzamos la recarga al login para limpiar completamente el circuito
        Navigation.NavigateTo("/", forceLoad: true);
    }
}