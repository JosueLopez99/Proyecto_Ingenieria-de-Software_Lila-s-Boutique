@page "/"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@using LilasBoutique.DTOs
@using LilasBoutique.Data
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Acceso - Lila's Boutique</PageTitle>

<div class="card shadow-lg border-0" style="width: 450px; border-radius: 1rem;">
    <div class="card-body p-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Lila's Boutique</h2>
            <p class="text-muted">Control de Inventario</p>
        </div>

        <EditForm Model="loginModel" OnValidSubmit="ValidarLogin" FormName="loginForm">
            <DataAnnotationsValidator />
            <AntiforgeryToken />

            <div class="mb-3">
                <label class="form-label fw-semibold">Correo Electrónico:</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <InputText @bind-Value="loginModel.Correo" class="form-control form-control-lg" placeholder="usuario@lilasboutique.com" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Contraseña:</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <InputText @bind-Value="loginModel.Password" type="password" class="form-control form-control-lg" placeholder="••••••••" />
                </div>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">Ingresar al Sistema</button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger mt-3 text-center" style="font-size: 0.9rem;">
                    @mensajeError
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    // Captura el contexto de la petición web para poder escribir la cookie
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public LoginDTO loginModel { get; set; } = new();

    private string mensajeError = "";

    [IgnoreAntiforgeryToken]
    private async Task ValidarLogin()
    {
        var usuario = await AuthService.ObtenerUsuarioPorCorreo(loginModel.Correo);

        if (usuario != null && usuario.EstadoActivo && BCrypt.Net.BCrypt.Verify(loginModel.Password, usuario.HashCredencial))
        {
            // 1. Preparamos los datos (Claims) del usuario para la Cookie
            var claims = new List<Claim>
            {
                new Claim(ClaimTypes.NameIdentifier, usuario.IdUsuario.ToString()),
                new Claim(ClaimTypes.Name, usuario.Correo),
                new Claim(ClaimTypes.Role, usuario.Rol.NombreRol)
            };

            var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            var principal = new ClaimsPrincipal(identity);

            // 2. Escribimos la Cookie encriptada en el navegador del usuario
            if (HttpContext != null)
            {
                await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
            }

            // 3. Forzamos la recarga (forceLoad: true) para que el servidor lea la nueva Cookie
            if (usuario.Rol.NombreRol == "Administrador")
                Navigation.NavigateTo("/dashboard", forceLoad: true);
            else if (usuario.Rol.NombreRol == "Vendedor")
                Navigation.NavigateTo("/catalogos", forceLoad: true);
            else
                Navigation.NavigateTo("/bodega", forceLoad: true);
        }
        else
        {
            mensajeError = "Credenciales incorrectas o usuario inactivo.";
        }
    }
}   
}